# Khóa AI. KHÔNG commit file .env. Chọn một nhà cung cấp bằng LLM_PROVIDER (claude hoặc gemini).
LLM_PROVIDER=claude
# Claude: https://console.anthropic.com (API key, cần nạp credit)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Gemini: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=8080
