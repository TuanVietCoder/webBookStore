# Tạo file .env cùng thư mục docker-compose.yml để Docker Compose đọc.
# Chỉ điền API key ở môi trường backend. KHÔNG đưa vào frontend hay Git.
OPENAI_API_KEY=
# Chatbot Client có thể dùng Claude thay OpenAI: để trống OPENAI_API_KEY (dùng ANTHROPIC_API_KEY ở dưới) hoặc đặt CLIENT_CHAT_PROVIDER=claude|openai.
# CLIENT_CHAT_PROVIDER=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=10000

# --- Trợ lý AI Admin (chạy ở backend). Chọn nhà cung cấp bằng LLM_PROVIDER=claude|gemini ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
