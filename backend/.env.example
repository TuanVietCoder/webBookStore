PORT=3000
HOST=127.0.0.1
# Chỉ bật tính năng thanh toán mô phỏng trong môi trường lab.
DEMO_PAYMENTS_ENABLED=true
# DATA_FILE=./data/db.json

# AI chatbot Client (chỉ đọc ở Backend; Node.js không tự tải file .env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=10000
# OPENAI_BASE_URL=https://api.openai.com/v1

# COVER_DIR=./storage/covers # Nơi lưu ảnh bìa JPG/PNG/WebP (mặc định backend/storage/covers)

# AI Admin (backend/src/llm/): chọn LLM_PROVIDER=claude hoặc gemini rồi điền khóa tương ứng. Backend tự đọc file .env.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
